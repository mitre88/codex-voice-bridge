# Copy to .env (same directory) and adjust. Loaded automatically on start;
# variables already set in your shell/environment always take precedence.
OPENAI_API_KEY=sk-proj-replace-me
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_TRANSLATE_MODEL=gpt-realtime-translate
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-realtime-whisper
# Assistant voice: marin | cedar | alloy | ash | ballad | coral | echo | sage | shimmer | verse
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TONE=calm
OPENAI_REALTIME_REASONING_EFFORT=low
OPENAI_REALTIME_TARGET_LANGUAGE=es
CODEX_VOICE_WORKDIR=/path/to/your/workspace
# Optional: override the global toggle shortcut (Electron accelerator syntax).
CODEX_VOICE_SHORTCUT=CommandOrControl+Shift+Space
# Optional: timeouts in milliseconds (positive integers; invalid values fall
# back to the defaults below).
CODEX_VOICE_TIMEOUT_MS=120000
CODEX_VOICE_CUA_TIMEOUT_MS=60000
CODEX_VOICE_OPENAI_TIMEOUT_MS=60000
# Optional: how long a pending local action waits for your Run/Reject answer
# before it is auto-rejected (default 120000 = 2 minutes).
CODEX_VOICE_ACTION_TIMEOUT_MS=120000
# Optional: set to 0 to keep the window from floating above other apps
# (default is always-on-top).
# CODEX_VOICE_ALWAYS_ON_TOP=0
# Optional: load a .env file from a custom location instead of <cwd>/.env.
# CODEX_VOICE_ENV_FILE=/absolute/path/to/.env
