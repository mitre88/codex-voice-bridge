{
  "name": "codex-voice-bridge",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "A local macOS voice bridge for OpenAI Realtime, Codex CLI, CUA Driver, and bidirectional interview translation.",
  "main": "src/main.js",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.mjs",
    "lint": "eslint src",
    "test": "node --test test/*.test.js",
    "smoke:cua": "bash scripts/smoke-cua.sh",
    "logs": "tail -f ~/Library/Logs/codex-voice-bridge/bridge.log",
    "dist": "electron-builder",
    "test:ui": "playwright test --config test/ui/playwright.config.js",
    "build:smoke": "electron-builder --mac --dir --arm64 -c.mac.identity=null",
    "dist:mac": "electron-builder --mac --arm64 --x64"
  },
  "keywords": [
    "openai",
    "realtime",
    "voice",
    "codex",
    "cua-driver",
    "macos",
    "translation",
    "interview"
  ],
  "author": "Alex Mitre",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "electron": "44.2.0",
    "@playwright/test": "1.58.2"
  },
  "build": {
    "appId": "com.mitre.codex-voice-bridge",
    "productName": "Codex Voice Bridge",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "minimumSystemVersion": "13.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Use your selected microphone for an explicitly connected voice session.",
        "NSScreenCaptureUsageDescription": "Capture meeting audio only when you select this route and connect."
      },
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist"
    }
  }
}
