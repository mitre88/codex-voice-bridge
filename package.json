{
  "name": "codex-voice-bridge",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "A local macOS voice bridge for OpenAI Realtime, Codex CLI, CUA Driver, and bidirectional interview translation.",
  "main": "src/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.cjs && node --check src/renderer.js && node --check src/lib.js && node --check src/renderer-utils.js",
    "lint": "eslint src test",
    "test": "node --test test/*.test.js",
    "smoke:cua": "bash scripts/smoke-cua.sh",
    "logs": "tail -f ~/Library/Logs/codex-voice-bridge/bridge.log",
    "dist": "electron-builder"
  },
  "keywords": [
    "openai",
    "realtime",
    "voice",
    "codex",
    "cua-driver",
    "macos",
    "translation",
    "interview"
  ],
  "author": "Alex Mitre",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^39.2.6",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5"
  },
  "build": {
    "appId": "com.mitre.codex-voice-bridge",
    "productName": "Codex Voice Bridge",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
